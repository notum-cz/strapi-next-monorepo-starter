{
  "name": "@repo/design-system",
  "version": "1.0.0",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./theme.css": "./src/styles/theme.css",
    "./styles.css": "./dist/styles.css",
    "./tiptap-color-config.json": "./dist/tiptap-color-config.json",
    "./tiptap-theme.css": "./dist/tiptap-theme.css",
    "./styles-strapi.json": "./dist/styles-strapi.json",
    "./ck-color-config.json": "./dist/ckeditor-color-config.json",
    "./ck-fontSize-config.json": "./dist/ckeditor-fontSize-config.json",
    "./source-styles.css": "./src/styles.css",
    "./colors.css": "./src/styles/colors.css",
    "./typography.css": "./src/styles/typography.css",
    "./shared.css": "./src/styles/shared.css",
    "./fonts.css": "./src/fonts.css"
  },
  "files": [
    "dist",
    "src/**/*.css",
    "src/fonts"
  ],
  "scripts": {
    "build": "node ./src/scripts/copy-fonts.mjs && tailwindcss -i ./src/styles.css -o ./dist/styles.css && node ./src/scripts/build-ck-config.js && node ./src/scripts/build-tiptap-config.js",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "lint": "eslint -c ../../eslint.config.mjs './**/*.{js,ts,jsx,tsx,cjs,mjs}'",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.1",
    "@tailwindcss/postcss": "4.3.1",
    "class-variance-authority": "0.7.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.1"
  },
  "devDependencies": {
    "postcss-modules-values": "4.0.0"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
