# Base URL of the application
# Example:
# - Local development: http://localhost:3000
# - Development: https://dev.example.com
# - Staging: https://staging.example.com
# - Production: https://www.example.com
BASE_URL=http://localhost:3000
# Enable testing against mobile viewports (true / false)
MOBILE_VIEWPORTS_TESTING_ENABLED=false
# Credentials for a real account used by the smoke sign-in test
# (e2e/smoke/sign-in.spec.ts) — must exist on the backend the tests target
SMOKE_SIGN_IN_EMAIL=
SMOKE_SIGN_IN_PASSWORD=