# Base URL of the application
# Example:
# - Local development: http://localhost:3000
# - Development: https://dev.example.com
# - Staging: https://staging.example.com
# - Production: https://www.example.com
BASE_URL=http://localhost:3000
# Optional. Comma-separated test groups to run (see helpers/test-groups.ts), e.g. homepage,auth.
# Unset or "auto" runs what ENV_GROUPS lists for the environment BASE_URL points at.
# QA_GROUPS=
# Enable testing against mobile viewports (true / false)
MOBILE_VIEWPORTS_TESTING_ENABLED=false