{
  "name": "@repo/tests-playwright",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "lhci-perfo-check": "tsx perfo/lhci.ts",
    "lint": "eslint -c ../../../eslint.config.mjs './**/*.{js,ts,jsx,tsx,cjs,mjs}'",
    "lint:fix": "pnpm lint --fix",
    "playwright-axe-test": "playwright test --project=axe --pass-with-no-tests",
    "playwright-e2e-mock-tests": "playwright test e2e/mock --pass-with-no-tests",
    "playwright-e2e-smoke-tests": "playwright test e2e/smoke --pass-with-no-tests",
    "playwright-e2e-tests": "playwright test e2e --pass-with-no-tests",
    "playwright-interactive-mode": "playwright test e2e --ui",
    "playwright-seo-tests": "playwright test --project=seo --pass-with-no-tests",
    "playwright-visual-tests": "playwright test --project=visual-chromium --project=visual-firefox --project=visual-webkit --pass-with-no-tests",
    "playwright-visual-tests-docker": "bash visual/compare-snapshots-docker.sh visual-chromium visual-firefox",
    "playwright-visual-update-snapshots-docker": "bash visual/update-snapshots-docker.sh visual-chromium visual-firefox",
    "playwright-visual-update-tests": "playwright test --project=visual-chromium --project=visual-firefox --project=visual-webkit --update-snapshots --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "axe-core": "4.14.0",
    "get-sitemap-links": "1.1.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "dotenv": "18.0.9",
    "eslint-plugin-playwright": "2.12.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^26.0.0"
  }
}
