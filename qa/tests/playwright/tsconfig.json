{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "dom"],
    "sourceMap": false,
    "types": ["@playwright/test", "node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // These run in the k6 runtime, not Node — load/ and perfo/ have their own tsconfig.
  "exclude": ["node_modules", "load", "perfo", "helpers/k6"]
}
