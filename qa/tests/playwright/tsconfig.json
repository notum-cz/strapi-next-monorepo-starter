{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "dom"],
    "sourceMap": false,
    "types": ["@playwright/test", "node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // load/ runs in the k6 runtime, not Node — it has its own tsconfig.
  "exclude": ["node_modules", "load"]
}
